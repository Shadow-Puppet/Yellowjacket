{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": [
    "specs/**/*.ts",
    "support/**/*.ts",
    "support/**/*.mjs",
    "playwright.config.ts"
  ]
}
